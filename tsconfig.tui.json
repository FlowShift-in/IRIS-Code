{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "rootDir": "./src/tui",
    "outDir": "./dist/src/tui",
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "types": ["node", "react"],

    "lib": ["ES2022"]
  },

  "include": ["src/tui"],
  "exclude": [
    "node_modules",
    "dist",
    "src/agents", // node-only — no JSX
    "src/cli", // node-only — no JSX
    "bin" // entry point — no JSX
  ]
}
